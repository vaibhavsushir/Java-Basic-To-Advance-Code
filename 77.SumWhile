import java.util.Scanner;

public class SumWhile {
    public static void main(String[] args) {
        System.out.println("Sum Using While Loop");
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        int i = 1, sum = 0;

        while (i <= n) {
            sum += i;
            i++;
        }
        System.out.println("Sum = " + sum);
    }
}
